# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
GUILD_ID=your_guild_id_here

# OAuth2 Configuration
OAUTH_REDIRECT_URI=http://localhost:3001/auth/discord/callback
REQUIRED_ROLE_ID=your_required_role_id_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web Dashboard Configuration
WEB_PORT=3001
# Required — the bot refuses to boot without this. Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here

# Twitch API Configuration (for stream notifications)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube Cookies (optional - improves radio variety with personalized recommendations)
# Option 1 (simplest): Extract cookies from browser at runtime
YOUTUBE_COOKIES_BROWSER=firefox
# Option 2: Use a Netscape-format cookies file
# YOUTUBE_COOKIES=data/cookies.txt

# TeamSpeak 6 Status Channel (optional - shows TS user count in a Discord voice channel)
TS6_API_KEY=your_ts6_serverquery_api_key
TS6_STATUS_CHANNEL_ID=your_discord_voice_channel_id

# "Hey Jerry" Voice Assistant
# Required for the feature to start at all — speech-to-text runs on Groq's hosted Whisper.
# Without it the bot logs "[VoiceAssistant] Disabled: GROQ_API_KEY is not set" and skips the feature.
GROQ_API_KEY=your_groq_api_key_here
# Wake-word model (optional). Defaults to tools/models/hey_jarvis_v0.1.onnx, installed
# by scripts/setup-voice.sh. Point this at a custom .onnx to change the wake phrase.
# WAKEWORD_MODEL_PATH=tools/models/hey_jerry.onnx
# Detection threshold 0.0-1.0 (optional, default 0.5). Lower = more sensitive, more false wakes.
# WAKEWORD_THRESHOLD=0.5
# Piper TTS has no env overrides: scripts/setup-voice.sh installs it at the fixed paths
# tools/piper/piper and tools/piper/nl_voice.onnx, and the bot looks for it only there.
# Intent parsing reuses OPENROUTER_API_KEY above.

# Hardcoded-ID overrides (optional — each falls back to the current in-code literal if unset)
GENERAL_CHANNEL_ID=your_general_channel_id_here
ACTIVITY_LOG_CHANNEL_ID=your_activity_log_channel_id_here
DJ_ROLE_ID=your_dj_role_id_here
BOT_ADMIN_USER_ID=your_bot_admin_user_id_here

# HITLIJN — separate public app (hitlijn/server.mjs, its own pm2 process on this port)
HITLIJN_PORT=3002
# Comma-separated list of origins allowed to embed/call the app. Starts with just the
# godcord.nl subdomain; once hitlijn.nl's A-records point at this VPS, add
# https://hitlijn.nl and https://www.hitlijn.nl to the list (comma-separated, no spaces).
HITLIJN_ORIGIN=https://hitlijn.godcord.nl
# Spotify app registration (Spotify Developer Dashboard) — used for the PKCE login +
# Web Playback SDK/Connect. In development mode the app has an allowlist of ~25 users;
# switch to extended/production mode before opening HITLIJN up beyond that.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
