# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
GUILD_ID=your_guild_id_here

# OAuth2 Configuration
OAUTH_REDIRECT_URI=http://localhost:3001/auth/discord/callback
REQUIRED_ROLE_ID=your_required_role_id_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web Dashboard Configuration
WEB_PORT=3001
# Required — the bot refuses to boot without this. Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here

# Twitch API Configuration (for stream notifications)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube Cookies (optional - improves radio variety with personalized recommendations)
# Option 1 (simplest): Extract cookies from browser at runtime
YOUTUBE_COOKIES_BROWSER=firefox
# Option 2: Use a Netscape-format cookies file
# YOUTUBE_COOKIES=data/cookies.txt

# TeamSpeak 6 Status Channel (optional - shows TS user count in a Discord voice channel)
TS6_API_KEY=your_ts6_serverquery_api_key
TS6_STATUS_CHANNEL_ID=your_discord_voice_channel_id

# Hardcoded-ID overrides (optional — each falls back to the current in-code literal if unset)
GENERAL_CHANNEL_ID=your_general_channel_id_here
ACTIVITY_LOG_CHANNEL_ID=your_activity_log_channel_id_here
DJ_ROLE_ID=your_dj_role_id_here
BOT_ADMIN_USER_ID=your_bot_admin_user_id_here
